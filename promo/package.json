{
  "name": "cuelume-promo",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "audio": "node scripts/audio.mjs",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render src/index.tsx CuelumePromo out/cuelume-promo-v5.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:preview": "remotion render src/index.tsx CuelumePromo out/cuelume-preview-v5.mp4 --scale=0.5 --crf=23"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@remotion/bundler": "4.0.521",
    "@remotion/cli": "4.0.521",
    "@remotion/renderer": "4.0.521",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.521"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
